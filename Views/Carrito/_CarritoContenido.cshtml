@model GymEcommerce.ViewModels.CarritoViewModel

@if (Model.Items.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-cart3 display-4 text-muted" aria-hidden="true"></i>
        <p class="lead mt-3">Tu carrito está vacío.</p>
        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-primary">Ver catálogo</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item py-3 @(item.Disponible ? "" : "carrito-item-problema")">
                            <div class="d-flex gap-3">
                                <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@item.IdProducto" class="flex-shrink-0">
                                    <img class="carrito-img" src="@Url.Content(item.ImagenUrl ?? "~/img/sin-imagen.svg")" alt="" />
                                </a>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between gap-2">
                                        <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@item.IdProducto"
                                           class="fw-medium text-dark text-decoration-none">@item.Nombre</a>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 js-quitar"
                                                data-id="@item.IdCarritoItem" data-nombre="@item.Nombre"
                                                aria-label="Quitar @item.Nombre del carrito" title="Quitar">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>

                                    <div class="small text-muted">
                                        @item.PrecioUnitario.ToString("C") c/u
                                        @if (item.EnOferta)
                                        {
                                            <del class="ms-1">@item.PrecioOriginal.ToString("C")</del>
                                        }
                                    </div>

                                    @if (!item.Activo)
                                    {
                                        <div class="small text-danger mt-1">Este producto ya no está disponible. Quitalo para continuar.</div>
                                    }
                                    else if (item.Stock < item.Cantidad)
                                    {
                                        <div class="small text-danger mt-1">
                                            @(item.Stock == 0 ? "Sin stock. Quitalo para continuar." : $"Solo quedan {item.Stock} unidades. Ajustá la cantidad.")
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-center mt-2 gap-2">
                                        <div class="input-group input-group-sm cantidad-control">
                                            <button type="button" class="btn btn-outline-secondary js-cantidad"
                                                    data-id="@item.IdCarritoItem" data-delta="-1"
                                                    disabled="@(item.Cantidad <= 1)" aria-label="Restar una unidad">
                                                <i class="bi bi-dash" aria-hidden="true"></i>
                                            </button>
                                            <input type="number" class="form-control text-center js-cantidad-input"
                                                   value="@item.Cantidad" min="1" max="@Math.Max(1, item.Stock)"
                                                   data-id="@item.IdCarritoItem" aria-label="Cantidad de @item.Nombre" />
                                            <button type="button" class="btn btn-outline-secondary js-cantidad"
                                                    data-id="@item.IdCarritoItem" data-delta="1"
                                                    disabled="@(item.Cantidad >= item.Stock)" aria-label="Sumar una unidad">
                                                <i class="bi bi-plus" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <div class="precio-final fs-5 text-nowrap">@item.Subtotal.ToString("C")</div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card carrito-resumen">
                <div class="card-body">
                    <h2 class="h5 mb-3">Resumen</h2>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Productos (@Model.CantidadTotal)</span>
                        <span>@Model.Subtotal.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Envío</span>
                        <span>@Model.TextoCostoEnvio</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fw-semibold">Total</span>
                        <span class="precio-final">@Model.Total.ToString("C")</span>
                    </div>
                    <p class="small text-muted mt-2 mb-3">@Model.TextoEnvio</p>

                    @if (Model.PuedeComprar)
                    {
                        <a class="btn btn-primary btn-lg w-100" asp-controller="Pedidos" asp-action="Checkout">Continuar compra</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-lg w-100" disabled>Continuar compra</button>
                        <p class="small text-danger mt-2 mb-0">Corregí los productos marcados para continuar.</p>
                    }
                    <a class="btn btn-link w-100 mt-1" asp-controller="Catalogo" asp-action="Index">Seguir comprando</a>
                </div>
            </div>
        </div>
    </div>
}
