@model GymEcommerce.ViewModels.MensajeViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center py-4">
        <i class="bi @Model.Icono display-4 text-primary" aria-hidden="true"></i>
        <h1 class="h3 mt-3">@Model.Titulo</h1>
        <p class="lead">@Model.Texto</p>

        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            @if (Model.TextoBoton is not null && Model.UrlBoton is not null)
            {
                <a class="btn btn-primary" href="@Model.UrlBoton">@Model.TextoBoton</a>
            }
            @if (Model.TextoSecundario is not null && Model.UrlSecundario is not null)
            {
                <a class="btn btn-outline-secondary" href="@Model.UrlSecundario">@Model.TextoSecundario</a>
            }
            <a class="btn btn-link" asp-controller="Home" asp-action="Index">Ir al inicio</a>
        </div>
    </div>
</div>
