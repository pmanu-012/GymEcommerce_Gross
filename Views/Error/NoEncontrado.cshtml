@{
    ViewData["Title"] = "Página no encontrada";
}

<div class="text-center py-5">
    <div class="gs-error-codigo" aria-hidden="true">404</div>
    <h1 class="h3 mt-2">No encontramos esta página</h1>
    <p class="text-muted">Puede que el enlace esté mal escrito o que el producto ya no esté disponible.</p>

    <form class="mx-auto my-4" style="max-width:420px" role="search" asp-area="" asp-controller="Catalogo" asp-action="Index" method="get">
        <div class="input-group">
            <input type="search" name="q" class="form-control" placeholder="Buscar productos..." aria-label="Buscar productos" />
            <button class="btn btn-primary" type="submit">Buscar</button>
        </div>
    </form>

    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Catalogo" asp-action="Index">Ver catálogo</a>
        <a class="btn btn-outline-secondary" asp-area="" asp-controller="Home" asp-action="Index">Ir al inicio</a>
    </div>
</div>
