@model GymEcommerce.ViewModels.CheckoutViewModel
@using GymEcommerce.ViewModels
@{
    ViewData["Title"] = "Finalizar compra";
    var carrito = Model.Carrito;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Carrito" asp-action="Index">Carrito</a></li>
        <li class="breadcrumb-item active" aria-current="page">Finalizar compra</li>
    </ol>
</nav>

<h1 class="h3 mb-4">Finalizar compra</h1>

<form id="formCheckout" asp-action="Checkout" method="post">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header fw-medium">Dirección de envío</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-sm-8">
                            <label asp-for="Calle" class="form-label"></label>
                            <input asp-for="Calle" class="form-control" autocomplete="address-line1" />
                            <span asp-validation-for="Calle" class="text-danger"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Numero" class="form-label"></label>
                            <input asp-for="Numero" class="form-control" />
                            <span asp-validation-for="Numero" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Ciudad" class="form-label"></label>
                            <input asp-for="Ciudad" class="form-control" autocomplete="address-level2" />
                            <span asp-validation-for="Ciudad" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Provincia" class="form-label"></label>
                            <select asp-for="Provincia" class="form-select"
                                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(CheckoutViewModel.Provincias))">
                                <option value="">Elegí una provincia</option>
                            </select>
                            <span asp-validation-for="Provincia" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="CodigoPostal" class="form-label"></label>
                            <input asp-for="CodigoPostal" class="form-control" autocomplete="postal-code" />
                            <span asp-validation-for="CodigoPostal" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mt-3 small mb-0">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                El pago es simulado: al confirmar, el pedido queda registrado como <strong>pendiente</strong>
                hasta que la tienda lo confirme.
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card carrito-resumen">
                <div class="card-body">
                    <h2 class="h5 mb-3">Tu pedido</h2>
                    <ul class="list-unstyled mb-3">
                        @foreach (var item in carrito.Items)
                        {
                            <li class="d-flex justify-content-between gap-2 mb-2 small">
                                <span>@item.Cantidad × @item.Nombre</span>
                                <span class="text-nowrap">@item.Subtotal.ToString("C")</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Subtotal</span><span>@carrito.Subtotal.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Envío</span><span>@carrito.TextoCostoEnvio</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                        <span class="fw-semibold">Total</span>
                        <span class="precio-final">@carrito.Total.ToString("C")</span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Confirmar compra</button>
                    <a class="btn btn-link w-100 mt-1" asp-controller="Carrito" asp-action="Index">Volver al carrito</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
