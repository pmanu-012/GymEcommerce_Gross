@{
    var seccion = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Administración - @Marca.Nombre</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar gs-navbar" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand gs-marca" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>@Marca.Nombre
                    <span class="admin-etiqueta">Admin</span>
                </a>
                <div class="d-flex align-items-center gap-3">
                    <a class="link-light small text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shop" aria-hidden="true"></i> <span class="d-none d-sm-inline">Ver tienda</span>
                    </a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-link link-light small p-0 text-decoration-none">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> <span class="d-none d-sm-inline">Cerrar sesión</span>
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0 flex-grow-1 d-flex">
        <div class="row g-0 flex-grow-1 w-100">
            <aside class="col-lg-3 col-xl-2 admin-sidebar" data-bs-theme="dark">
                <button class="btn btn-outline-light w-100 my-2 d-lg-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#adminMenu" aria-expanded="false" aria-controls="adminMenu">
                    <i class="bi bi-list" aria-hidden="true"></i> Menú
                </button>
                <nav id="adminMenu" class="collapse d-lg-block" aria-label="Menú de administración">
                    <ul class="nav flex-column admin-nav">
                       <li class="nav-item">
                            <a class="nav-link @(seccion == "Home" ? "active" : "")"
                               asp-area="Admin" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2" aria-hidden="true"></i> Resumen
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Pedidos" ? "active" : "")"
                               asp-area="Admin" asp-controller="Pedidos" asp-action="Index">
                                <i class="bi bi-receipt" aria-hidden="true"></i> Pedidos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Clientes" ? "active" : "")"
                               asp-area="Admin" asp-controller="Clientes" asp-action="Index">
                                <i class="bi bi-people" aria-hidden="true"></i> Clientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Productos" ? "active" : "")"
                               asp-area="Admin" asp-controller="Productos" asp-action="Index">
                                <i class="bi bi-box-seam" aria-hidden="true"></i> Productos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Ingresos" ? "active" : "")"
                               asp-area="Admin" asp-controller="Ingresos" asp-action="Index">
                                <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> Ingresos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Resenas" ? "active" : "")"
                               asp-area="Admin" asp-controller="Resenas" asp-action="Index">
                                <i class="bi bi-chat-left-quote" aria-hidden="true"></i> Reseñas
                           </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Auditoria" ? "active" : "")"
                               asp-area="Admin" asp-controller="Auditoria" asp-action="Index">
                                <i class="bi bi-journal-text" aria-hidden="true"></i> Auditoría
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Categorias" ? "active" : "")"
                               asp-area="Admin" asp-controller="Categorias" asp-action="Index">
                                <i class="bi bi-tags" aria-hidden="true"></i> Categorías

                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Subcategorias" ? "active" : "")"
                               asp-area="Admin" asp-controller="Subcategorias" asp-action="Index">
                                <i class="bi bi-diagram-3" aria-hidden="true"></i> Subcategorías

                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "Disciplinas" ? "active" : "")"
                               asp-area="Admin" asp-controller="Disciplinas" asp-action="Index">
                                <i class="bi bi-bullseye" aria-hidden="true"></i> Disciplinas

                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccion == "GruposMusculares" ? "active" : "")"
                               asp-area="Admin" asp-controller="GruposMusculares" asp-action="Index">
                                <i class="bi bi-activity" aria-hidden="true"></i> Grupos musculares

                            </a>
                        </li>
                        @* Se suman acá: categorías, subcategorías, disciplinas, grupos musculares, pedidos, clientes, estadísticas y auditoría. *@
                    </ul>
                </nav>
            </aside>

            <main class="col-lg-9 col-xl-10 p-3 p-lg-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/alertas.js" asp-append-version="true"></script>
    <script src="~/js/admin-productos.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["Exito"] is string exito)
    {
        <script>Alertas.exito(@Json.Serialize(exito));</script>
    }
</body>
</html>
