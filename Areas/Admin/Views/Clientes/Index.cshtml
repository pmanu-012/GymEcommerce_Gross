@model ClienteListadoViewModel
@{
    ViewData["Title"] = "Clientes";

    string Pag(int pagina) => Url.Action("Index", new { q = Model.Q, estado = Model.Estado, pagina })!;
}

@Html.AntiForgeryToken()

<h1 class="h3 mb-3">Clientes</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input asp-for="Q" class="form-control" placeholder="Nombre, email o teléfono..." aria-label="Buscar cliente" />
    </div>
    <div class="col-md-4">
        <select asp-for="Estado" class="form-select" aria-label="Estado">
            <option value="activos">Activos</option>
            <option value="inactivos">Dados de baja</option>
            <option value="todos">Todos</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </div>
</form>

<p class="text-muted small">@Model.Total @(Model.Total == 1 ? "cliente" : "clientes")</p>

@if (Model.Clientes.Count == 0)
{
    <div class="alert alert-info">No hay clientes con esos filtros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle tabla-admin bg-white">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Teléfono</th>
                    <th class="text-end">Pedidos</th>
                    <th class="text-end">Total comprado</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Clientes)
                {
                    <tr>
                        <td>
                            <div class="fw-medium">@c.Apellido, @c.Nombre</div>
                            <div class="small text-muted">@c.Email</div>
                        </td>
                        <td>@(c.Telefono ?? "—")</td>
                        <td class="text-end">@c.Pedidos</td>
                        <td class="text-end text-nowrap">@c.TotalGastado.ToString("C")</td>
                        <td>
                            <span class="badge @(c.Activo ? "text-bg-success" : "text-bg-secondary")">@(c.Activo ? "Activo" : "De baja")</span>
                            @if (!c.EmailConfirmado)
                            {
                                <span class="badge text-bg-warning">Email sin confirmar</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@c.Id"
                               title="Ver" aria-label="Ver a @c.Nombre @c.Apellido"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id"
                               title="Editar" aria-label="Editar a @c.Nombre @c.Apellido"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <button type="button"
                                    class="btn btn-sm @(c.Activo ? "btn-outline-danger" : "btn-outline-success") js-estado-cliente"
                                    data-url="@Url.Action("CambiarEstado", new { id = c.Id })"
                                    data-nombre="@c.Nombre @c.Apellido"
                                    data-activo="@(c.Activo ? "true" : "false")"
                                    title="@(c.Activo ? "Dar de baja" : "Reactivar")"
                                    aria-label="@(c.Activo ? "Dar de baja" : "Reactivar") a @c.Nombre @c.Apellido">
                                <i class="bi @(c.Activo ? "bi-person-x" : "bi-person-check")" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Pag(Model.Pagina - 1)">Anterior</a>
                </li>
                @for (var p = Math.Max(1, Model.Pagina - 2); p <= Math.Min(Model.TotalPaginas, Model.Pagina + 2); p++)
                {
                    <li class="page-item @(p == Model.Pagina ? "active" : "")">
                        <a class="page-link" href="@Pag(p)">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" href="@Pag(Model.Pagina + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
}

@section Scripts {
    <script src="~/js/admin-clientes.js" asp-append-version="true"></script>
}
