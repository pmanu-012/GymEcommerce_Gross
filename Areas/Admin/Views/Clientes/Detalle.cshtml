@model ClienteDetalleViewModel
@using GymEcommerce.Services
@{
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
}

@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Nombre @Model.Apellido</h1>
        <span class="badge @(Model.Activo ? "text-bg-success" : "text-bg-secondary")">@(Model.Activo ? "Activo" : "De baja")</span>
        @if (!Model.EmailConfirmado)
        {
            <span class="badge text-bg-warning">Email sin confirmar</span>
        }
        @if (Model.Bloqueado)
        {
            <span class="badge text-bg-danger">Bloqueado por intentos fallidos</span>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil" aria-hidden="true"></i> Editar
        </a>
        <button type="button"
                class="btn btn-sm @(Model.Activo ? "btn-outline-danger" : "btn-outline-success") js-estado-cliente"
                data-url="@Url.Action("CambiarEstado", new { id = Model.Id })"
                data-nombre="@Model.Nombre @Model.Apellido"
                data-activo="@(Model.Activo ? "true" : "false")">
            <i class="bi @(Model.Activo ? "bi-person-x" : "bi-person-check")" aria-hidden="true"></i>
            @(Model.Activo ? "Dar de baja" : "Reactivar")
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-medium">Contacto</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt class="small text-muted fw-normal">Email</dt>
                    <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
                    <dt class="small text-muted fw-normal">Teléfono</dt>
                    <dd class="mb-0">@(Model.Telefono ?? "—")</dd>
                </dl>
            </div>
        </div>

        <div class="row row-cols-3 g-2">
            <div class="col"><div class="card admin-kpi"><div class="card-body p-2">
                <div class="small text-muted">Pedidos</div><div class="fs-5 fw-semibold">@Model.CantidadPedidos</div>
            </div></div></div>
            <div class="col"><div class="card admin-kpi"><div class="card-body p-2">
                <div class="small text-muted">Comprado</div><div class="fs-6 fw-semibold text-nowrap">@Model.TotalGastado.ToString("C0")</div>
            </div></div></div>
            <div class="col"><div class="card admin-kpi"><div class="card-body p-2">
                <div class="small text-muted">Reseñas</div><div class="fs-5 fw-semibold">@Model.CantidadResenas</div>
            </div></div></div>
        </div>
        <p class="small text-muted mt-2">Los totales no incluyen pedidos cancelados.</p>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header fw-medium">Pedidos</div>
            @if (Model.Pedidos.Count == 0)
            {
                <div class="card-body text-muted">Este cliente todavía no hizo pedidos.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr><th>N°</th><th>Fecha</th><th>Estado</th><th class="text-end">Total</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Pedidos)
                            {
                                <tr>
                                    <td class="fw-medium">#@p.IdPedido</td>
                                    <td class="text-nowrap">@Fechas.ALocal(p.Fecha).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge @p.Estado.ClaseBadge()">@p.Estado.Texto()</span></td>
                                    <td class="text-end text-nowrap">@p.Total.ToString("C")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Pedidos" asp-action="Detalle" asp-route-id="@p.IdPedido">Ver</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-clientes.js" asp-append-version="true"></script>
}
