@model ProductoFormViewModel
@{
    var esEdicion = Model.IdProducto != 0;
    ViewData["Title"] = esEdicion ? "Editar producto" : "Nuevo producto";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al listado</a>
</div>

<form asp-action="@(esEdicion ? "Edit" : "Create")" asp-route-id="@(esEdicion ? Model.IdProducto : (int?)null)"
      method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <input type="hidden" asp-for="IdProducto" />
    <input type="hidden" asp-for="RowVersion" />

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="card mb-4">
                <div class="card-header fw-medium">Datos del producto</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" maxlength="150" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="300"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Uso" class="form-label"></label>
                            <input asp-for="Uso" class="form-control" maxlength="100" />
                            <span asp-validation-for="Uso" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Material" class="form-label"></label>
                            <input asp-for="Material" class="form-control" maxlength="100" />
                            <span asp-validation-for="Material" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-medium">Precio y stock</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label asp-for="Precio" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Precio" class="form-control" inputmode="decimal" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="PorcentajeDescuento" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="PorcentajeDescuento" class="form-control" inputmode="decimal" autocomplete="off" />
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="form-text">Dejalo vacío si no hay oferta.</div>
                            <span asp-validation-for="PorcentajeDescuento" class="text-danger"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Stock" class="form-label"></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-medium">Clasificación</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="IdCategoria" class="form-label"></label>
                            <select asp-for="IdCategoria" asp-items="Model.Categorias" class="form-select"
                                    data-url-subcategorias="@Url.Action("Subcategorias")">
                                <option value="">Elegí una categoría</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="IdSubcategoria" class="form-label"></label>
                            <select asp-for="IdSubcategoria" asp-items="Model.Subcategorias" class="form-select">
                                <option value="">Elegí una subcategoría</option>
                            </select>
                            <span asp-validation-for="IdSubcategoria" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-label">Disciplinas <span class="text-muted small">(opcional)</span></div>
                        @if (Model.Disciplinas.Count == 0)
                        {
                            <div class="text-muted small">Todavía no hay disciplinas cargadas.</div>
                        }
                        @foreach (var d in Model.Disciplinas)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="DisciplinasSeleccionadas"
                                       value="@d.Value" id="disc-@d.Value"
                                       checked="@Model.DisciplinasSeleccionadas.Contains(int.Parse(d.Value))" />
                                <label class="form-check-label" for="disc-@d.Value">@d.Text</label>
                            </div>
                        }
                    </div>

                    <div>
                        <div class="form-label">Grupos musculares <span class="text-muted small">(solo equipamiento de gimnasio)</span></div>
                        @if (Model.Grupos.Count == 0)
                        {
                            <div class="text-muted small">Todavía no hay grupos musculares cargados.</div>
                        }
                        @foreach (var g in Model.Grupos)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="GruposSeleccionados"
                                       value="@g.Value" id="grupo-@g.Value"
                                       checked="@Model.GruposSeleccionados.Contains(int.Parse(g.Value))" />
                                <label class="form-check-label" for="grupo-@g.Value">@g.Text</label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header fw-medium">Imagen</div>
                <div class="card-body">
                    <img id="vistaPrevia" src="@Url.Content(Model.ImagenActual ?? "~/img/sin-imagen.svg")"
                         class="img-thumbnail mb-3 w-100" style="max-width:260px" alt="Vista previa de la imagen" />
                    <input type="hidden" asp-for="ImagenActual" />
                    <input asp-for="Imagen" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG, PNG o WEBP. Máximo 2 MB.</div>
                    <span asp-validation-for="Imagen" class="text-danger"></span>

                    @if (!string.IsNullOrEmpty(Model.ImagenActual))
                    {
                        <div class="form-check mt-3">
                            <input asp-for="QuitarImagen" class="form-check-input" />
                            <label asp-for="QuitarImagen" class="form-check-label"></label>
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" role="switch" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg">@(esEdicion ? "Guardar cambios" : "Crear producto")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validacion-decimal.js" asp-append-version="true"></script>
}
